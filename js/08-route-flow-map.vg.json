            "lon": 130.88185,
            "location_name": "Darwin International Airport / RAAF Darwin",
            "ident": "YPDN"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -9,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "airport"
        }
      }
    }
  ]
}
