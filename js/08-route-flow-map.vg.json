            "location_name": "Cairns International Airport",
            "ident": "YBCS"
          },
          {
            "airport": "Hobart",
            "iata": "HBA",
            "state": "TAS",
            "lat": -42.83703,
            "lon": 147.51302,
            "location_name": "Hobart International Airport",
            "ident": "YMHB"
          },
          {
            "airport": "Darwin",
            "iata": "DRW",
