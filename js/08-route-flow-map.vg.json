          },
          {
            "airport": "Perth",
            "iata": "PER",
            "state": "WA",
            "lat": -31.9403,
            "lon": 115.967,
            "location_name": "Perth International Airport",
            "ident": "YPPH"
          },
          {
            "airport": "Adelaide",
            "iata": "ADL",
            "state": "SA",
            "lat": -34.94751,
            "lon": 138.53339,
            "location_name": "Adelaide International Airport",
            "ident": "YPAD"
          },
          {
            "airport": "Cairns",
